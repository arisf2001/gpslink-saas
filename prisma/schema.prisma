generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlanCategory {
  WHITE_LABEL
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  BLOCKED
  CANCELED
}

model Plan {
  id          String       @id @default(cuid())
  category    PlanCategory
  devices     Int
  name        String
  priceCents  Int          @default(0)
  currency    String       @default("usd")
  features    String       @db.Text
  active      Boolean      @default(true)
  highlighted Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  companies   Company[]

  @@unique([category, devices])
}

// Yearly price per device; the tier is picked by how many active devices the company has.
model PriceTier {
  id         String   @id @default(cuid())
  minDevices Int      @unique
  priceCents Int      @default(0)
  currency   String   @default("usd")
  updatedAt  DateTime @updatedAt
}

model Company {
  id                   String         @id @default(cuid())
  name                 String
  slug                 String         @unique
  contactName          String
  email                String         @unique
  phone                String
  passwordHash         String
  planId               String
  plan                 Plan           @relation(fields: [planId], references: [id])
  status               CompanyStatus  @default(TRIAL)
  trialEndsAt          DateTime
  gpswoxUserId         Int?
  deviceLimit          Int            @default(50)
  billingEnabled       Boolean        @default(true)
  provisionError       String?        @db.Text
  stripeCustomerId     String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  invoices             Invoice[]
  notifications        Notification[]
  devices              BilledDevice[]
  aiEnabled            Boolean        @default(false)
  aiName               String?
  brandColor           String?
  websiteUrl           String?        @db.VarChar(300)
  subdomain            String?        @unique @db.VarChar(40)
  clientPlans          ClientPlan[]
  endClients           EndClient[]
}

// One GPSWOX device of a company. nextBillAt is when it must appear on an invoice (trial end or its yearly anniversary).
model BilledDevice {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceId   Int
  addedAt    DateTime
  nextBillAt DateTime
  removedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([companyId, deviceId])
}

model Invoice {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  dueAt          DateTime
  devices        Int
  newDevices     Int
  renewals       Int
  unitPriceCents Int
  aiCents        Int       @default(0)
  amountCents    Int
  currency       String    @default("usd")
  status         String    @default("OPEN")
  paidAt         DateTime?
  method         String?
  reference      String?   @unique
  note           String?
  createdAt      DateTime  @default(now())

  @@unique([companyId, periodStart])
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      String
  dedupeKey String   @unique
  channels  String
  error     String?  @db.Text
  createdAt DateTime @default(now())
}

model MockDevice {
  id           Int      @id @default(autoincrement())
  gpswoxUserId Int
  createdAt    DateTime @default(now())
  name         String?
  other        String?  @db.Text
  reportedAt   DateTime?
}

model ProcessedEvent {
  id        String   @id
  createdAt DateTime @default(now())
}

// A white label's own plan for its clients: price per device for each period of `months`.
model ClientPlan {
  id         String      @id @default(cuid())
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  priceCents Int
  currency   String      @default("usd")
  months     Int         @default(12)
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  clients    EndClient[]
}

// A GPSWOX user under a white label: its client, one of its dealers, or a dealer's client.
// Without a plan it never expires.
model EndClient {
  id           String          @id @default(cuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  gpswoxUserId Int
  managerId    Int?
  email        String
  phone        String?
  isDealer     Boolean         @default(false)
  devices      Int             @default(0)
  planId       String?
  plan         ClientPlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  paidUntil    DateTime?
  blockReason  String?
  goneAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  payments     ClientPayment[]
  notices      ClientNotice[]

  @@unique([companyId, gpswoxUserId])
}

model ClientPayment {
  id          String    @id @default(cuid())
  endClientId String
  endClient   EndClient @relation(fields: [endClientId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String
  periods     Int
  method      String
  note        String?
  paidUntil   DateTime
  createdAt   DateTime  @default(now())
}

model ClientNotice {
  id          String    @id @default(cuid())
  endClientId String
  endClient   EndClient @relation(fields: [endClientId], references: [id], onDelete: Cascade)
  kind        String
  dedupeKey   String    @unique
  channels    String
  error       String?   @db.Text
  createdAt   DateTime  @default(now())
}

model MockClient {
  id        Int      @id @default(autoincrement())
  managerId Int
  email     String
  phone     String?
  groupId   Int      @default(2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AiSetting {
  id                Int      @id @default(1)
  enabled           Boolean  @default(false)
  monthlyPriceCents Int      @default(0)
  model             String   @default("gpt-5-mini")
  updatedAt         DateTime @updatedAt
}

model AiAppKey {
  id        String    @id @default(cuid())
  name      String
  prefix    String
  keyHash   String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model AiConversation {
  id           String   @id @default(cuid())
  gpswoxUserId Int
  companyId    String?
  channel      String
  messages     String   @db.LongText
  turns        Int      @default(0)
  tokensIn     Int      @default(0)
  tokensOut    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, createdAt])
}

model AiPin {
  gpswoxUserId Int       @id
  pinHash      String
  failed       Int       @default(0)
  lockedUntil  DateTime?
  updatedAt    DateTime  @updatedAt
}

model AiConfirm {
  id           String    @id
  gpswoxUserId Int
  deviceId     Int
  deviceName   String
  command      String
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
}

model AiCommandLog {
  id           String   @id @default(cuid())
  gpswoxUserId Int
  companyId    String?
  deviceId     Int
  deviceName   String
  command      String
  channel      String
  ok           Boolean
  error        String?  @db.Text
  createdAt    DateTime @default(now())
}

model WaSession {
  companyId String    @id
  want      Boolean   @default(false)
  status    String    @default("OFF")
  qr        String?   @db.Text
  phone     String?
  error     String?   @db.Text
  beatAt    DateTime?
  updatedAt DateTime  @updatedAt
}

model WaLink {
  id             String    @id @default(cuid())
  companyId      String
  phone          String
  gpswoxUserId   Int
  hashSealed     String    @db.Text
  conversationId String?
  pendingToken   String?   @db.Text
  pendingUntil   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, phone])
}

model WaOutbox {
  id        Int       @id @default(autoincrement())
  companyId String
  phone     String
  text      String    @db.Text
  status    String    @default("pending")
  error     String?   @db.Text
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status, companyId])
}

model MetaSetting {
  id              Int      @id @default(1)
  enabled         Boolean  @default(false)
  phoneNumberId   String?
  wabaId          String?
  tokenSealed     String?  @db.Text
  appSecretSealed String?  @db.Text
  verifyToken     String
  template        String?
  templateLang    String   @default("es")
  graphVersion    String   @default("v23.0")
  updatedAt       DateTime @updatedAt
}

model MetaLog {
  id        Int      @id @default(autoincrement())
  direction String
  phone     String
  text      String   @db.Text
  wamid     String?  @unique
  ok        Boolean  @default(true)
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AlertSetting {
  id           Int      @id @default(1)
  enabled      Boolean  @default(true)
  ownerPhone   String?  @db.VarChar(30)
  lowBattery   Int      @default(20)
  offlineHours Int      @default(24)
  updatedAt    DateTime @updatedAt
}

model DeviceAlertState {
  deviceId  Int      @id
  state     String   @db.Text
  updatedAt DateTime @updatedAt
}

model DeviceAlert {
  id         Int      @id @default(autoincrement())
  deviceId   Int
  deviceName String
  companyId  String?
  kind       String
  sentTo     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// "Prueba gratis": the account is only created after the 6-digit email code is confirmed. payload is AES-GCM encrypted (contains the password).
model SignupVerification {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  payload   String   @db.Text
  attempts  Int      @default(0)
  resends   Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// OAuth 2.0 for voice/AI assistants (Gemini custom app via MCP, Alexa account linking).
// The customer signs in with their GPS Link user/password; tokens map to their sealed user_api_hash.
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  secretHash   String?
  name         String
  redirectUris String   @db.Text
  createdAt    DateTime @default(now())
}

model OAuthCode {
  id          String   @id @default(cuid())
  codeHash    String   @unique
  clientId    String
  redirectUri String   @db.Text
  challenge   String?
  sealedHash  String   @db.Text
  brand       String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model OAuthToken {
  id               String   @id @default(cuid())
  accessHash       String   @unique
  refreshHash      String   @unique
  clientId         String
  sealedHash       String   @db.Text
  brand            String?
  expiresAt        DateTime
  refreshExpiresAt DateTime
  createdAt        DateTime @default(now())

  @@index([clientId])
}

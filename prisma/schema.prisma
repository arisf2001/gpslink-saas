generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlanCategory {
  WHITE_LABEL
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  BLOCKED
  CANCELED
}

model Plan {
  id          String       @id @default(cuid())
  category    PlanCategory
  devices     Int
  name        String
  priceCents  Int          @default(0)
  currency    String       @default("usd")
  features    String       @db.Text
  active      Boolean      @default(true)
  highlighted Boolean      @default(false)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  companies   Company[]

  @@unique([category, devices])
}

// Yearly price per device; the tier is picked by how many active devices the company has.
model PriceTier {
  id         String   @id @default(cuid())
  minDevices Int      @unique
  priceCents Int      @default(0)
  currency   String   @default("usd")
  updatedAt  DateTime @updatedAt
}

model Company {
  id                   String         @id @default(cuid())
  name                 String
  slug                 String         @unique
  contactName          String
  email                String         @unique
  phone                String
  passwordHash         String
  planId               String
  plan                 Plan           @relation(fields: [planId], references: [id])
  status               CompanyStatus  @default(TRIAL)
  trialEndsAt          DateTime
  gpswoxUserId         Int?
  deviceLimit          Int            @default(50)
  provisionError       String?        @db.Text
  stripeCustomerId     String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  invoices             Invoice[]
  notifications        Notification[]
  devices              BilledDevice[]
}

// One GPSWOX device of a company. nextBillAt is when it must appear on an invoice (trial end or its yearly anniversary).
model BilledDevice {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceId   Int
  addedAt    DateTime
  nextBillAt DateTime
  removedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([companyId, deviceId])
}

model Invoice {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  dueAt          DateTime
  devices        Int
  newDevices     Int
  renewals       Int
  unitPriceCents Int
  amountCents    Int
  currency       String    @default("usd")
  status         String    @default("OPEN")
  paidAt         DateTime?
  method         String?
  reference      String?   @unique
  note           String?
  createdAt      DateTime  @default(now())

  @@unique([companyId, periodStart])
}

model Notification {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      String
  dedupeKey String   @unique
  channels  String
  error     String?  @db.Text
  createdAt DateTime @default(now())
}

model MockDevice {
  id           Int      @id @default(autoincrement())
  gpswoxUserId Int
  createdAt    DateTime @default(now())
}

model ProcessedEvent {
  id        String   @id
  createdAt DateTime @default(now())
}
